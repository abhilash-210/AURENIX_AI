# ──────────────────────────────────────────────────────────────────────────────
# Operating System
# ──────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────────────────────────────────────
# IDEs & Editors
# ──────────────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ──────────────────────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# Jupyter
.ipynb_checkpoints
*.ipynb

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Ruff / Pylint
.ruff_cache/

# ──────────────────────────────────────────────────────────────────────────────
# Node / Frontend
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn/
.pnp.*
.next/
out/
.nuxt/
dist/
.cache/
.parcel-cache/
.vite/

# ──────────────────────────────────────────────────────────────────────────────
# Secrets & Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.production.example
!.env*.example
*.pem
*.key
*.cert
secrets/
credentials/

# ──────────────────────────────────────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────────────────────────────────────
*.log
docker-compose.override.yml

# ──────────────────────────────────────────────────────────────────────────────
# Databases & Vector Stores
# ──────────────────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
chroma_db/
faiss_index/
*.pkl
*.pickle

# ──────────────────────────────────────────────────────────────────────────────
# AI / ML Artifacts
# ──────────────────────────────────────────────────────────────────────────────
models/
checkpoints/
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.onnx
wandb/
mlruns/

# ──────────────────────────────────────────────────────────────────────────────
# Temporary & Build Artifacts
# ──────────────────────────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
*.bak
*.orig
storage/uploads/*
!storage/uploads/.gitkeep
backend/storage/
.build/

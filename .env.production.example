# ==============================================================================
# Aurenix AI — Production Environment Variables Template (.env.production)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.production on your production server.
# 2. Populate all required values with strong, securely generated secrets.
# 3. NEVER commit .env.production to version control.
# ==============================================================================

# ── Application Environment ───────────────────────────────────────────────────
APP_ENV=production
APP_NAME=Aurenix AI
APP_VERSION=0.1.0
DEBUG=false

# ── Server Binding ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Production CORS ───────────────────────────────────────────────────────────
# Restrict strictly to your production domain(s). Multiple domains comma-separated.
CORS_ORIGINS=https://aurenix.ai,https://app.aurenix.ai

# ── Logging Configuration ─────────────────────────────────────────────────────
# Use JSON format for log aggregator ingestion (Datadog, Loki, CloudWatch)
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Relational Database (PostgreSQL) ──────────────────────────────────────────
POSTGRES_USER=aurenix
POSTGRES_PASSWORD=generate_a_secure_32_char_database_password_here
POSTGRES_DB=aurenix_db

# Async SQLAlchemy DSN for application connection
DATABASE_URL=postgresql+asyncpg://aurenix:generate_a_secure_32_char_database_password_here@postgres:5432/aurenix_db

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32  (Must be >= 32 characters)
JWT_SECRET_KEY=generate_a_secure_random_64_hex_character_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM & Embedding Providers ─────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-actual-production-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your-actual-production-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Database (Qdrant) ──────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=aurenix_documents
QDRANT_MEMORY_COLLECTION_NAME=aurenix_memories

# ── Redis Cache & State ───────────────────────────────────────────────────────
REDIS_PASSWORD=generate_a_secure_redis_password_here
REDIS_URL=redis://:generate_a_secure_redis_password_here@redis:6379/0

# ── Storage & Uploads ─────────────────────────────────────────────────────────
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=25

# ── Frontend Configuration (Injected into Next.js) ────────────────────────────
NEXT_PUBLIC_API_URL=https://api.aurenix.ai/api/v1

# Environment variable reference for the Aurenix AI backend.
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────────────────────

# Runtime environment: "development" | "production" | "testing"
APP_ENV=development

# Human-readable application name (used in logs and OpenAPI docs)
APP_NAME=Aurenix AI

# Semantic version displayed in /api/v1/health
APP_VERSION=0.1.0

# Set to "true" to enable OpenAPI docs (/docs, /redoc) in non-production envs
DEBUG=true

# ──────────────────────────────────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────────────────────────────────

# Host the uvicorn server binds to
HOST=0.0.0.0

# Port the uvicorn server listens on
PORT=8000

# ──────────────────────────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins.
# In production, restrict to your actual frontend domain.
# Example: https://app.aurenix.ai,https://staging.aurenix.ai
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────────────────

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format: "json" (structured, for production) | "text" (human-readable, for dev)
LOG_FORMAT=text

# ──────────────────────────────────────────────────────────────────────────────
# Database  (Sprint 2+)
# ──────────────────────────────────────────────────────────────────────────────

# Async SQLAlchemy DSN.
# Development / CI (SQLite, zero-config):
#   DATABASE_URL=sqlite+aiosqlite:///./aurenix_dev.db
# Production (PostgreSQL):
#   DATABASE_URL=postgresql+asyncpg://aurenix:your_password@localhost:5432/aurenix_db
DATABASE_URL=sqlite+aiosqlite:///./aurenix_dev.db

# ──────────────────────────────────────────────────────────────────────────────
# JWT Authentication  (Sprint 2+)
# ──────────────────────────────────────────────────────────────────────────────

# Signing secret for HS256 JWTs.
# REQUIRED — minimum 32 characters.
# Generate a strong secret: openssl rand -hex 32
# NEVER commit the real value to version control.
JWT_SECRET_KEY=changeme-replace-in-production-use-openssl-rand-hex-32

# JWT signing algorithm (HS256 is recommended for single-server deployments).
JWT_ALGORITHM=HS256

# Lifetime of access tokens (in minutes). Default: 30 minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Lifetime of refresh tokens (in days). Used from Sprint 3 onwards.
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
